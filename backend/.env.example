# ===== GROQ AI CONFIGURATION (OPTIONAL) =====
# Groq API key for llama models
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq API endpoint (default is production endpoint)
GROQ_API_URL=https://api.groq.com/openai/v1

# Groq model to use (default: llama-3.3-70b-versatile)
# Other options: llama-3.1-405b-reasoning, mixtral-8x7b-32768, etc.
GROQ_MODEL=llama-3.3-70b-versatile

# ===== AI MODEL CONFIGURATION =====
# Override default economic model (must be a supported model)
# Default: llama-3.3-70b-versatile (cost-optimized)
# Options: llama-3.3-70b-versatile, llama-3.1-405b-reasoning
AI_MODEL_DEFAULT=llama-3.3-70b-versatile

# ===== FIREBASE CONFIGURATION (OPTIONAL) =====
# Only needed if you want to store analysis history
USE_FIREBASE=false
USE_FIREBASE_STORAGE=false
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ===== SERVER CONFIGURATION =====
PORT=3001
NODE_ENV=development

