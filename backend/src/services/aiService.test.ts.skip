import { AIService } from './aiService';
import type { AIServiceConfig } from '../types/analysis';

jest.mock('groq-sdk', () => {
  return {
    __esModule: true,
    default: jest.fn().mockImplementation(() => ({
      chat: {
        completions: {
          create: jest.fn(),
        },
      },
    })),
  };
});

describe('AIService', () => {
  let aiService: AIService;
  let mockCreate: jest.Mock;

  const config: AIServiceConfig = {
    apiKey: 'test-api-key',
    apiUrl: 'https://api.groq.com/openai/v1',
    model: 'llama-3.3-70b-versatile',
  };

  beforeEach(() => {
    jest.clearAllMocks();
    aiService = new AIService(config);
    
    const Groq = require('groq-sdk').default;
    const groqInstance = new Groq();
    mockCreate = groqInstance.chat.completions.create as jest.Mock;
  });

  describe('analyzeJobFit', () => {
    it('should return valid analysis result with high fit score', async () => {
      const mockResponse = {
        choices: [
          {
            message: {
              content: JSON.stringify({
                hardSkillsDetected: ['React', 'TypeScript', 'Node.js'],
                mandatoryRequirementsMet: ['5+ years experience', 'TypeScript'],
                mandatoryRequirementsMissing: [],
                desirableRequirementsMet: ['GraphQL'],
                desirableRequirementsMissing: [],
                softSkillsEvidence: ['Led team'],
                seniorityMatch: 'match',
                redFlags: [],
                recruiterMessage: 'Great fit for this role',
              }),
            },
          },
        ],
      };

      mockCreate.mockResolvedValue(mockResponse);

      const cv = 'Senior Engineer with 5 years React/TypeScript experience';
      const jobDescription = 'Looking for Senior Engineer with React/TypeScript';

      const result = await aiService.analyzeJobFit(cv, jobDescription);

      expect(result.fitScore).toBeGreaterThan(70);
      expect(result.decision).toBe('apply');
      expect(result.strengths.length).toBeGreaterThan(0);
      expect(result.explanation).toBeDefined();
      expect(result.promptVersion).toBe('v1.1');
    });

    it('should return analysis with gaps when requirements missing', async () => {
      const mockResponse = {
        choices: [
          {
            message: {
              content: JSON.stringify({
                hardSkillsDetected: ['JavaScript'],
                mandatoryRequirementsMet: [],
                mandatoryRequirementsMissing: ['TypeScript', 'React'],
                desirableRequirementsMet: [],
                desirableRequirementsMissing: ['GraphQL'],
                softSkillsEvidence: [],
                seniorityMatch: 'below',
                redFlags: ['Lack of experience'],
                recruiterMessage: 'Significant gaps',
              }),
            },
          },
        ],
      };

      mockCreate.mockResolvedValue(mockResponse);

      const cv = 'Junior Developer with 1 year JavaScript';
      const jobDescription = 'Senior React/TypeScript Engineer needed';

      const result = await aiService.analyzeJobFit(cv, jobDescription);

      expect(result.fitScore).toBeLessThan(50);
      expect(result.decision).toBe('skip');
      expect(result.gaps.length).toBeGreaterThan(0);
    });

    it('should throw error when AI returns invalid JSON', async () => {
      const mockResponse = {
        choices: [
          {
            message: {
              content: 'This is not valid JSON',
            },
          },
        ],
      };

      mockCreate.mockResolvedValue(mockResponse);

      await expect(
        aiService.analyzeJobFit('CV', 'Job Description')
      ).rejects.toThrow();
    });

    it('should throw error when AI returns incomplete data', async () => {
      const mockResponse = {
        choices: [
          {
            message: {
              content: JSON.stringify({
                hardSkillsDetected: ['React'],
              }),
            },
          },
        ],
      };

      mockCreate.mockResolvedValue(mockResponse);

      await expect(
        aiService.analyzeJobFit('CV', 'Job Description')
      ).rejects.toThrow(/Missing required fields/);
    });

    it('should include prompt version in result', async () => {
      const mockResponse = {
        choices: [
          {
            message: {
              content: JSON.stringify({
                hardSkillsDetected: [],
                mandatoryRequirementsMet: [],
                mandatoryRequirementsMissing: [],
                desirableRequirementsMet: [],
                desirableRequirementsMissing: [],
                softSkillsEvidence: [],
                seniorityMatch: 'match',
                redFlags: [],
                recruiterMessage: 'Test',
              }),
            },
          },
        ],
      };

      mockCreate.mockResolvedValue(mockResponse);

      const result = await aiService.analyzeJobFit('CV', 'Job');
      expect(result.promptVersion).toBe('v1.1');
    });

    it('should call Groq API with correct parameters', async () => {
      const mockResponse = {
        choices: [
          {
            message: {
              content: JSON.stringify({
                hardSkillsDetected: [],
                mandatoryRequirementsMet: [],
                mandatoryRequirementsMissing: [],
                desirableRequirementsMet: [],
                desirableRequirementsMissing: [],
                softSkillsEvidence: [],
                seniorityMatch: 'match',
                redFlags: [],
                recruiterMessage: 'Test',
              }),
            },
          },
        ],
      };

      mockCreate.mockResolvedValue(mockResponse);

      await aiService.analyzeJobFit('Test CV', 'Test Job');

      expect(mockCreate).toHaveBeenCalledWith(
        expect.objectContaining({
          model: 'llama-3.3-70b-versatile',
          temperature: expect.any(Number),
          max_tokens: expect.any(Number),
          messages: expect.arrayContaining([
            expect.objectContaining({
              role: 'user',
              content: expect.stringContaining('Test CV'),
            }),
          ]),
        })
      );
    });
  });
});
